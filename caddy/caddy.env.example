# Copy to /etc/caddy/caddy.env and fill in your values.
# chmod 600 /etc/caddy/caddy.env  (contains secrets!)

# Email used for Let's Encrypt registration / expiry notices.
ACME_EMAIL=you@example.com

# AWS region of your Route 53 hosted zone (Route 53 is global, but the SDK
# still wants a region; us-east-1 is a safe default).
AWS_REGION=us-east-1

# --- AWS credentials ---
# OPTION A (recommended on EC2): DO NOT set these. Attach an IAM instance
#   role with the policy from iam-policy.json and Caddy will use it
#   automatically via the instance metadata service.
#
# OPTION B: Use a dedicated IAM user's access keys (uncomment below).
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
