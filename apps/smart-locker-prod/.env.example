# Copy to .env and fill in strong values.  chmod 600 .env  (contains secrets!)

# ---- JWT ----
# Signing secret for access tokens. Generate a strong random value, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=60

# ---- Bootstrap accounts (seeded on first startup, idempotent) ----
# Passwords are hashed with bcrypt before storage. Use strong passwords.
# Leave a password blank to skip creating that account.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

SEED_AGENT_USERNAME=agent
SEED_AGENT_PASSWORD=

SEED_CUSTOMER_USERNAME=customer
SEED_CUSTOMER_PASSWORD=

# ---- Business config (same knobs as the POC) ----
STORAGE_UNIT_RATE=1
HOLD_TIMEOUT_SECONDS=120
